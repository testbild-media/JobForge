# JobForge – Beispielkonfiguration für die lokale Entwicklung.
# Kopieren nach .env und anpassen. Produktiv legt install.sh /etc/jobforge/jobforge.env an.

DEBUG=1
SECRET_KEY=bitte-einen-langen-zufaelligen-wert-eintragen
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Standard: SQLite in ./data. Für PostgreSQL:
# DATABASE_URL=postgres://jobforge:passwort@localhost:5432/jobforge
# DATA_DIR=./data

# HTTPS=1               # erzwingt Secure-Cookies + HSTS (sonst automatisch über X-Forwarded-Proto)
# TIME_ZONE=Europe/Berlin

# E-Mail-Versand (optional)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=buero@example.com
